{
  "name": "drag-trainer",
  "version": "1.0.0",
  "description": "Learn to drag click: per-drag stats, a coach, practice reminders and a how-to guide",
  "main": "dist/main.js",
  "author": "urmamge",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron .",
    "dist": "tsc && electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.urmamge.dragtrainer",
    "productName": "Drag Trainer",
    "files": [
      "dist/**/*",
      "static/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Drag-Trainer.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  }
}
